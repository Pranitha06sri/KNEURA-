# Default: same-origin /api, proxied by Vite to localhost:8000.
VITE_API_BASE_URL=/api
# Server options (set in the shell running uvicorn):
# KNEURA_DATA_DIR=.kneura
# KNEURA_CHECKPOINT=path/to/original-checkpoint.pt
# Optional chat-completions-compatible endpoint for actual narrative report generation:
# KNEURA_LLM_URL=http://localhost:1234/v1/chat/completions
# KNEURA_LLM_MODEL=your-local-model
# KNEURA_LLM_KEY=

# Local Vite proxy target (not a browser-visible secret):
# KNEURA_API_PROXY=http://127.0.0.1:8000
# Allowed browser origins for state-changing requests (comma-separated):
# KNEURA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only when serving the application through HTTPS:
# KNEURA_SECURE_COOKIE=1
# Backend settings must be exported in the server shell; Python does not auto-load .env.

# Genuine narrative LLM (chat-completions-compatible JSON output required):
# LLM_PROVIDER=local-or-approved-provider
# KNEURA_LLM_URL=http://127.0.0.1:1234/v1/chat/completions
# KNEURA_LLM_MODEL=your-actual-language-model
# KNEURA_LLM_KEY=
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# Finals reproducibility and authorized clinical input:
# KNEURA_REQUIRE_SERIES_CSV=1
# KNEURA_SERIES_CSV=data/series_eligibility.csv
# KNEURA_DEMO_MRI_DIR=demo_data/knee_mri
# KNEURA_DEMO_AUTHORIZATION=.kneura/demo-authorization.json
